{
  "compilerOptions": {
    "module": "commonjs", 
    "forceConsistentCasingInFileNames": true, 
    "strict": true, 
    "noImplicitAny": false,
    "skipLibCheck": true, 
    "outDir": "dist",
    "declaration": true,
    "target": "ESNext",
    "sourceMap": true,
    "baseUrl": ".",
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "vitest.config.ts", "src/types"]
}
